# Use an organization you own. Never point this at an organization you do not control.

# Organization slug, not the display name.
SENTRY_ORG=

# Project slug. Create a fresh project named noise-repro (python bootstrap.py).
SENTRY_PROJECT=noise-repro

# DSN of that project (Project Settings → Client Keys).
SENTRY_DSN=

# Internal integration token (Issue & Event: Admin).
SENTRY_TOKEN=

# Internal integration client secret. Used only to verify webhook signatures.
SENTRY_CLIENT_SECRET=

# API host. Default is the US SaaS region. For a region pin use https://us.sentry.io
# or a host like de.sentry.io. Do not put the ingest host here.
SENTRY_HOST=https://sentry.io

# Optional team slug used by bootstrap.py when the org has more than one team.
SENTRY_TEAM=

# Safety switches. DRY_RUN defaults to true. Set both of these for the live repro.
DRY_RUN=true
MIN_AGE_DAYS=7

# Pull-job gate: sum of the last WINDOW_HOURS hourly buckets must reach THRESHOLD.
THRESHOLD=50
WINDOW_HOURS=24

# One recorded action per issue, and at most this many per UTC day.
DAILY_CAP=20

# Comma-separated project slugs. Defaults to SENTRY_PROJECT.
# No action is taken against any other project.
ALLOWED_PROJECTS=

# Skip issues with no assignee when true.
REQUIRE_OWNER=false

# Write one raw webhook body to samples/event_alert.json. Sandbox only.
# The payload contains event data. Leave this false.
SAVE_WEBHOOK_SAMPLE=false
